# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Model routing (see app/config.py) - override per environment without touching code
CLAUDE_EXTRACTION_MODEL=claude-haiku-4-5-20251001
CLAUDE_SCORING_MODEL=claude-sonnet-5

# Database - defaults to local SQLite if unset. Railway will inject a Postgres DATABASE_URL.
DATABASE_URL=sqlite:///./investor_scoring.db

# Upload limits
MAX_UPLOAD_MB=25
